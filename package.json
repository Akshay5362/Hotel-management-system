{
  "name": "webline-pms",
  "productName": "HPMS",
  "author": {
    "name": "Webline",
    "email": "info@webline.com"
  },
  "description": "Professional Hotel Property Management System",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend:dev": "cross-env HPMS_ENV=development npm run --prefix backend dev",
    "dev:seed": "cross-env HPMS_ENV=development node backend/scripts/seedDevFirestore.mjs",
    "dev:seed:auth": "cross-env HPMS_ENV=development node backend/scripts/seedDevAuthUsers.mjs",
    "electron:local": "wait-on http://localhost:5173 http://localhost:5000/api/health --timeout 60000 && cross-env ELECTRON_MODE=local NODE_ENV=development HPMS_ENV=development electron .",
    "electron:docker-dev": "wait-on http://localhost:5173 http://localhost:5000/api/health --timeout 120000 && cross-env ELECTRON_MODE=docker-dev NODE_ENV=development HPMS_ENV=development electron .",
    "electron:docker": "wait-on http://localhost:5000/api/health --timeout 120000 && cross-env ELECTRON_MODE=docker NODE_ENV=development HPMS_ENV=development electron .",
    "electron:prod": "npm run build && cross-env ELECTRON_MODE=production NODE_ENV=production HPMS_ENV=production electron .",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac --x64"
  },
  "build": {
    "appId": "com.hotel.hpms",
    "productName": "HPMS",
    "copyright": "Copyright © 2026 Hotel Sky-5",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/win-unpacked/**",
      "!dist/mac/**",
      "!dist/*.exe",
      "!dist/*.dmg",
      "!dist/*.zip",
      "!dist/*.yml",
      "!dist/builder-debug.yml",
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!db_data/**",
          "!tests/**",
          "!scratch/**",
          "!*.md",
          "!test-data-cleanup-backup/**"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "HPMS Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HPMS",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "identity": null
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName} Setup ${version}-mac-x64.${ext}"
    }
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.0",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1",
    "wait-on": "^9.0.10"
  }
}
