# Webline PMS Plus / Hotel Sky-5 Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# Backend Express API Port
PORT=5000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Akshu@5362
