# Webline PMS Plus / Hotel Sky-5 Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# Backend Express API Port
PORT=5000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hotel_pms

# Environment Mode
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Frontend API Base URL (Vite Environment Variable)
# ─────────────────────────────────────────────────────────────────────────────
# For Local Development (Default):
VITE_API_BASE_URL=http://localhost:5000

# For Ngrok Testing (Override VITE_API_BASE_URL in .env.local):
# VITE_API_BASE_URL=https://quarters-frugality-revolving.ngrok-free.dev

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Client SDK Public Configuration (HPMS-Sky5)
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hpms-sky5
VITE_FIREBASE_STORAGE_BUCKET=hpms-sky5.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Feature Flags
ENABLE_STRICT_RBAC=true
ENABLE_FIREBASE_AUTH=false
