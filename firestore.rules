rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global Deny-by-Default Fallback ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helper Functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated() && request.auth.token.role != null
        ? request.auth.token.role
        : 'guest';
    }

    function isAdmin() {
      return getUserRole() == 'admin' || getUserRole() == 'super_admin';
    }

    function isStaff() {
      return getUserRole() == 'admin' || getUserRole() == 'super_admin' || getUserRole() == 'staff' || getUserRole() == 'receptionist';
    }

    function isOwner(userUid) {
      return isAuthenticated() && request.auth.uid == userUid;
    }

    function isHousekeeping() {
      return getUserRole() == 'housekeeping';
    }

    function isManager() {
      return getUserRole() == 'manager' || isAdmin();
    }

    function isKitchen() {
      return getUserRole() == 'kitchen' || getUserRole() == 'chef' || isAdmin();
    }

    // Kitchen field-level guard: kitchen cannot modify financial, destination, or identity fields
    function isKitchenSafeUpdate() {
      let protectedFields = [
        'items', 'subtotal', 'tax_total', 'grand_total',
        'payment_status', 'food_payment_id', 'ledger_item_id',
        'complimentary_id', 'complimentary_request_id',
        'billed_at', 'billed_by_uid',
        'room_number', 'room_id', 'booking_id',
        'guest_id', 'guest_name',
        'waiter_uid', 'waiter_name',
        'destination_type', 'order_number',
        'created_by_uid', 'order_id'
      ];
      return !protectedFields.hasAny(request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Collection Rules ──────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{userUid} {
      allow read: if isOwner(userUid) || isStaff();
      allow write: if isOwner(userUid) || isAdmin();
    }

    // A guest document is created and maintained server-side at signup and
    // provisioning (authController -> createGuestFirestore / updateGuestFirestore,
    // Admin SDK). The clauses below bound direct client-SDK access only.
    //
    // The former single `write` rule tested request.resource.data.user_uid - the
    // INCOMING document - which on an update is entirely attacker-controlled. Any
    // authenticated user could therefore overwrite ANY other guest record by
    // supplying their own uid, destroying or hijacking it. create and update are
    // now separated so an update is judged on the document that already exists,
    // and ownership itself is pinned.
    match /guests/{guestId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.user_uid == request.auth.uid);

      // Create: a guest may only bring into existence a record owned by itself.
      allow create: if isStaff()
                    || (isAuthenticated() && request.resource.data.user_uid == request.auth.uid);

      // Update: the EXISTING document must already belong to the caller, and
      // user_uid may not change - so ownership can neither be seized nor handed
      // away.
      allow update: if isStaff()
                    || (isAuthenticated()
                        && resource.data.user_uid == request.auth.uid
                        && request.resource.data.user_uid == resource.data.user_uid);

      // Delete: no guest-facing deletion workflow exists anywhere in the
      // application (deleteGuestFirestore has no caller), and a guest record is
      // referenced by bookings, invoices and history. Staff only.
      allow delete: if isStaff();
    }

    // Server-owned: roomsRepository (Admin SDK) via the room state machine. A
    // direct client write could mark a room vacant while occupied, or delete it.
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Server-owned: bookingsRepository and the check-in / check-out / room-shift
    // services (Admin SDK). A booking carries dates, status and money; a direct
    // client write - and `write` also covers delete - would bypass the entire
    // state machine, the folio and the audit trail.
    match /bookings/{bookingId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.user_uid == request.auth.uid);
      allow write: if false;

      match /ledger_items/{itemId} {
        allow read: if isStaff() || (isAuthenticated() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.user_uid == request.auth.uid);
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if isStaff() || (isAuthenticated() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.user_uid == request.auth.uid);
        allow write: if false;
      }

      match /history/{historyId} {
        allow read: if isStaff() || (isAuthenticated() && get(/databases/$(database)/documents/bookings/$(bookingId)).data.user_uid == request.auth.uid);
        allow write: if false; // Immutable — Admin SDK only
      }
    }

    // Server-owned: reservationsRepository and reservationFirestoreAdapter
    // (Admin SDK) via reservationController — every write in the codebase goes
    // through those, and no client uses the Firestore SDK. A reservation holds
    // guest name, contact, dates and rate, and the former `write` also covered
    // delete, so a staff token could have erased a booking commitment outright.
    // Read is unchanged.
    match /reservations/{reservationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stay_extensions/{extensionId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.user_uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_uid == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_uid == request.auth.uid;
      allow write: if isStaff();
    }

    // ── Phase 2 — Previously Uncovered Collections ───────────────────────────

    match /room_types/{typeId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventory_categories/{categoryId} {
      // Server-only writes. Categories are master data mutated exclusively
      // through the Express API (Admin SDK), which enforces MANAGE-role
      // authorization; a client SDK may only read.
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventory_products/{productId} {
      // Server-only writes. Since Phase A this document carries the
      // AUTHORITATIVE stock balance — current_stock, stock_by_location,
      // stock_quantity and last_movement_at are written only by the
      // transactional ledger core, paired with an inventory_stock_movements
      // entry. A direct client write would move stock without a ledger row,
      // so it is denied outright rather than restricted by role.
      allow read: if isStaff();
      allow write: if false;
    }

    // Phase A additions. All Inventory writes go through the Express API using
    // the Firebase Admin SDK, which is not subject to these rules — this block
    // only bounds direct client-SDK access as defense in depth.
    match /inventory_units/{unitId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventory_locations/{locationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventory_suppliers/{supplierId} {
      // Supplier contact details stay admin-only to READ, per Phase A scope;
      // writes go through the API like every other master.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inventory_stock_movements/{movementId} {
      // Append-only ledger: readable by staff, never writable from a client —
      // every movement is written server-side inside a Firestore transaction.
      allow read: if isStaff();
      allow write: if false;
    }

    // Phase B — purchase requests. A request to BUY: never an order, a
    // receipt, a stock change or a payment. Writes go exclusively through the
    // Express API (Admin SDK), which enforces the DRAFT/PENDING_APPROVAL state
    // machine and per-request ownership; a client SDK may only read.
    match /purchase_requests/{requestId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /purchase_request_items/{requestItemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Phase E — purchase orders. The formal document issued to a supplier:
    // created from exactly one approved request, immutable once ISSUED, and it
    // never changes stock. Writes go exclusively through the Express API
    // (Admin SDK), which enforces the DRAFT→ISSUED machine and MANAGE-only
    // authorization; a client SDK may only read.
    match /purchase_orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /purchase_order_items/{orderItemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Phase F — goods receipts. The only purchasing document accompanied by a
    // real stock increase: the receipt, its lines, the purchase-order state and
    // the stock ledger all commit in ONE server-side transaction. Receipts are
    // immutable once written, so a client SDK may only read them.
    match /goods_receipts/{receiptId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /goods_receipt_items/{receiptItemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Phase G — goods receipt reversals. An immutable correction record
    // proving who reversed which receipt, why, when, and which compensating
    // stock movements cancelled it. The original receipt is never deleted or
    // edited, so this collection is the only place a reversal is recorded —
    // making it client-writable would let a client forge or erase a correction
    // to the stock ledger. Server-only writes, exactly like the ledger itself.
    match /goods_receipt_reversals/{reversalId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Document-number counters (PR-YYYYMMDD-NNNNNN). Server-only: a client
    // must never be able to read or advance a sequence.
    match /inventory_counters/{counterId} {
      allow read, write: if false;
    }

    // Phase H1 — supplier bills. The uploaded document itself lives on the
    // server filesystem and is streamed through an authenticated, role-gated
    // route; only this metadata envelope is in Firestore. A bill carries
    // purchase pricing, so reads are restricted to staff and every write goes
    // through the Express API (Admin SDK), which owns the status lifecycle and
    // the rule that a confirmed bill can never be discarded.
    match /inventory_bills/{billId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventory_bill_lines/{lineId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Server-owned: inventoryApprovalAuthoritiesRepository (Admin SDK) via
    // inventoryApprovalAuthoritiesController. Phase H1. Unlike the other
    // inventory collections this denies READ as well: the documents hold staff
    // WhatsApp numbers and verification metadata, which no client screen needs
    // and which the API serves to administrators only.
    match /inventory_approval_authorities/{authorityId} {
      allow read, write: if false;
    }

    // Server-owned: inventoryApprovalActionsRepository (Admin SDK). Phase H2.
    // One-time approval action tokens. Read is denied along with write: the
    // documents are keyed by the SHA-256 of a secret, and letting a client
    // enumerate ids or consumption state would hand it an oracle. The raw token
    // is never stored here, so a leak of this collection yields nothing
    // presentable, but there is no reason for a client to see it at all.
    match /inventory_approval_actions/{actionId} {
      allow read, write: if false;
    }

    // Server-owned: whatsappWebhookEventsRepository (Admin SDK). Phase H5.
    // The exactly-once claim for an inbound Meta webhook delivery. A client
    // that could create a document here would pre-claim an event id and
    // silently suppress a real approval decision, and a client that could read
    // one would learn message ids it has no business seeing — so both are
    // denied. The rows hold a digest of the delivery, never its contents.
    match /whatsapp_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // Server-owned: cashLogsRepository / cashSubmissionsRepository (Admin SDK)
    // via cashController. Cash records are the reconciliation trail.
    match /cash_logs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /cash_submissions/{submissionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Server-owned: auditLogsRepository (Admin SDK). An audit log is only
    // evidence if the subject of the audit cannot author it, so client create is
    // removed and entries can no longer be forged.
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Server-owned: invoicesRepository (Admin SDK) via invoiceController. An
    // invoice must always correspond to a real folio.
    match /invoices/{invoiceId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.user_uid == request.auth.uid);
      allow write: if false;
    }

    match /housekeeping/{recordId} {
      allow read: if isStaff() || isHousekeeping();
      allow create: if isStaff();
      allow update: if isStaff() || isHousekeeping();
      allow delete: if isAdmin();
    }

    // Server-owned: bookingHistoryRepository (Admin SDK). Append-only history.
    match /booking_history/{historyId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Server-owned: paymentsRepository (Admin SDK) via paymentController. Client
    // create is removed so a payment record can never be fabricated for money
    // that was never collected.
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Server-owned: ledgerRepository (Admin SDK). Folio charges are money.
    match /ledger_items/{itemId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /razorpay_transactions/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Highly Sensitive Collections: Server-Side / Admin SDK Only
    match /checkout_snapshots/{snapshotId} {
      allow read, write: if false;
    }

    match /daily_analytics/{analyticsId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── Food / Restaurant POS Collections ────────────────────────────────────

    match /food_menu_categories/{categoryId} {
      allow read:   if isStaff() || isKitchen();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /food_menu_items/{itemId} {
      allow read:   if isStaff() || isKitchen();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /food_tax_config/{configId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    match /food_tables/{tableId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    match /food_orders/{orderId} {
      allow read:   if isStaff() || isKitchen();
      allow create: if isStaff();
      allow update: if isAdmin() || (isKitchen() && isKitchenSafeUpdate());
      allow delete: if isAdmin();
    }

    // Server-owned: foodPaymentsRepository (Admin SDK) via the food billing
    // controller. Immutable payment audit trail.
    match /food_payments/{paymentId} {
      allow read:   if isStaff();
      allow write:  if false;
    }

    match /food_complimentary_requests/{reqId} {
      allow read:   if isStaff() || isManager();
      allow create: if isStaff();
      allow update: if isManager(); // Admin / Manager approval
      allow delete: if false;       // Immutable audit records
    }

    match /food_order_counters/{dateId} {
      allow read, write: if false; // Strict Admin SDK only
    }
  }
}
